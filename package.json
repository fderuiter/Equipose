{
  "name": "equipose",
  "version": "1.32.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ng": "ng",
    "start": "ng serve",
    "start:pwa": "ng serve --configuration pwa",
    "dev": "ng serve --port=3000",
    "build": "ng build && node scripts/generate-manifest.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "vitest run --exclude 'tests_e2e/**'",
    "test:e2e:a11y": "playwright test tests_e2e/a11y.spec.ts",
    "lint:code": "ng lint",
    "lint:md": "node scripts/check-markdown-links.js",
    "lint": "run-p lint:code lint:md",
    "prestart": "node generate-version.js",
    "prebuild": "node generate-version.js",
    "pretest": "node generate-version.js",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "verify:logic": "vitest run src/app/domain/randomization-engine/core/randomization-algorithm-golden.spec.ts",
    "fixtures:generate": "tsx scripts/generate-golden-fixtures.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@ngrx/signals": "^21.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.6",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@angular/platform-browser-dynamic": "22.0.6",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.4.0",
    "fast-check": "^4.8.0",
    "glob": "^13.0.6",
    "jsdom": "^29.1.0",
    "markdown-link-check": "^3.14.2",
    "npm-run-all": "^4.1.5",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.12",
    "semantic-release": "^25.0.7",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "packageManager": "pnpm@11.1.3",
  "license": "AGPL-3.0-or-later"
}
